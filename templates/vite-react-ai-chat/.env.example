# Written at build time by the Forging Builder `deploy_ai_app` tool.
# Do not hand-edit — `register_ai_app` regenerates this file on each
# deploy with the app's registered ID, name, and greeting.
#
# All three VITE_ variables land in the built JS, but none of them is
# a secret: the APP_ID is public, and auth / credit deduction live on
# the platform side.

VITE_FORGING_APP_ID=app_placeholder
VITE_FORGING_APP_NAME=My AI App
VITE_FORGING_APP_GREETING=Ask me anything.

# For local dev only. In production the frontend is same-origin with
# the proxy so this stays empty.
# VITE_FORGING_PROXY_BASE=http://localhost:8002
